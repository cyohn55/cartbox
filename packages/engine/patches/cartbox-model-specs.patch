+// Cartbox fork: the base display dimensions are overridable at build time via -D
+// so a second "pro" core build can select a larger fixed spec (640x360) while the
+// classic build compiles to the exact upstream values. Guards leave classic
+// untouched (no -D => the original defaults) and keep the change upstream-friendly.
+#ifndef TIC80_WIDTH
 #define TIC80_WIDTH             240
+#endif
+#ifndef TIC80_HEIGHT
 #define TIC80_HEIGHT            136
+#endif
+#ifndef TIC80_FULLWIDTH_BITS
 #define TIC80_FULLWIDTH_BITS    8
+#endif
 #define TIC80_FULLWIDTH         (1 << TIC80_FULLWIDTH_BITS)
+// Cartbox fork: the overscan buffer's height is derived from its width at 16:9,
+// which cannot express a portrait model — at 360x640 the widest sensible
+// FULLWIDTH (512) yields a 288-line buffer, far short of the 640 the screen
+// needs. Overridable at build time so the portrait core can state its own
+// height; undefined it keeps the exact upstream derivation, so the classic and
+// pro builds are unaffected.
+#ifndef TIC80_FULLHEIGHT
 #define TIC80_FULLHEIGHT        (TIC80_FULLWIDTH*9/16)
+#endif
 
 #define TIC80_MARGIN_TOP        ((TIC80_FULLHEIGHT - TIC80_HEIGHT) / 2)
 #define TIC80_MARGIN_BOTTOM     TIC80_MARGIN_TOP
