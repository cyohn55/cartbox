@@ -71,9 +71,38 @@ inline u8 tic_tool_peek1(const void* addr, u32 index)
     return PEEK_N(addr, index, 3,7,0,1);
 }
 
+// One pixel per byte (8bpp). Unlike peek1/2/4 there is no sub-byte packing, so
+// this is a plain indexed access. Used by the pro core's 8bpp framebuffer.
+inline void tic_tool_poke8(void* addr, u32 index, u8 value)
+{
+    ((u8*)addr)[index] = value;
+}
+
+inline u8 tic_tool_peek8(const void* addr, u32 index)
+{
+    return ((const u8*)addr)[index];
+}
+
 #undef PEEK_N
 #undef POKE_N
 
+// Framebuffer, color-mapping table, and blit source are all stored at the
+// palette bit depth: 4bpp on the classic core, 8bpp on the pro core. These
+// selectors let the shared draw/blit code address a screen pixel without
+// hardcoding the packing; on the classic build they expand to the exact 4bpp
+// calls it used before, so its behavior is unchanged.
+#if TIC_PALETTE_BPP == 8
+#   define tic_tool_peek_screen         tic_tool_peek8
+#   define tic_tool_poke_screen         tic_tool_poke8
+#   define tic_api_peek_pix(mem, idx)        tic_api_peek((mem), (idx), 8)
+#   define tic_api_poke_pix(mem, idx, val)   tic_api_poke((mem), (idx), (val), 8)
+#else
+#   define tic_tool_peek_screen         tic_tool_peek4
+#   define tic_tool_poke_screen         tic_tool_poke4
+#   define tic_api_peek_pix(mem, idx)        tic_api_peek4((mem), (idx))
+#   define tic_api_poke_pix(mem, idx, val)   tic_api_poke4((mem), (idx), (val))
+#endif
+
